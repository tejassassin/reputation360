{
  "name": "reputation360",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/kill-vite-ports.mjs && node scripts/clear-vite-cache.mjs && node scripts/dev.mjs",
    "dev:simple": "node scripts/dev.mjs",
    "dev:next": "next dev",
    "build:next": "next build",
    "start:next": "next start",
    "dev:kill": "node scripts/kill-vite-ports.mjs",
    "dev:fresh": "node scripts/kill-vite-ports.mjs && node scripts/clear-vite-cache.mjs && node scripts/dev.mjs",
    "dev:vercel": "npx vercel dev",
    "start": "npm run dev",
    "doctor": "node scripts/doctor.mjs",
    "env:init": "node scripts/init-free-scan-env.mjs",
    "check:exports": "node scripts/check-export-reexport.mjs",
    "verify:imports": "node scripts/verify-critical-imports.mjs",
    "verify:links": "node scripts/verify-link-rel-policy.mjs",
    "verify:ssr-templates": "node scripts/verify-ssr-templates.mjs",
    "prebuild": "npm run check:exports && npm run verify:imports && npm run verify:links",
    "build": "next build && node scripts/purge-vercel-cache-after-build.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs && node scripts/sync-home-jsonld.mjs",
    "lint": "eslint .",
    "preview": "node scripts/dev.mjs preview",
    "local:prod": "node scripts/dev.mjs build && node scripts/dev.mjs preview",
    "verify:live": "node scripts/verify-live-deploy.mjs",
    "verify:live:about": "node scripts/verify-live-deploy.mjs /about",
    "verify:live:preview": "R360_LIVE_URL=https://reputation360-delta.vercel.app node scripts/verify-live-deploy.mjs",
    "purge:vercel-cache": "node scripts/purge-vercel-cache.mjs --yes",
    "verify:cache-consistency": "node scripts/verify-cache-consistency.mjs"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.36.1",
    "@tsparticles/engine": "^3.9.1",
    "@tsparticles/react": "^3.0.0",
    "@tsparticles/slim": "^3.9.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.563.0",
    "mini-svg-data-uri": "^1.4.4",
    "motion": "^12.29.2",
    "next": "^15.5.23",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-multi-carousel": "^2.8.6",
    "react-responsive-carousel": "^3.2.23",
    "remark-gfm": "^4.0.1",
    "resend": "^4.0.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "20.17.6",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.8.2",
    "vite": "^7.2.4"
  }
}
